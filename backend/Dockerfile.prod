# Use the same Python base image (with custom registry)
FROM docker.iranserver.com/python:3.14-slim

# Set Python environment variables for production
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_INDEX_URL=https://pypi.devneeds.ir/simple/ \
    DJANGO_SETTINGS_MODULE=core.settings \
    DEBUG=False

# Create a non‑root user for running the application (security)
RUN addgroup --system django && \
    adduser --system --ingroup django django

WORKDIR /app

# Copy requirements first – leverages Docker cache
COPY requirements.txt /app/

# Upgrade pip and install dependencies without caching (smaller image)
RUN pip3 install --upgrade pip && \
    pip3 install --no-cache-dir -r requirements.txt

# Copy the entire Django project source code
COPY src /app/

# Create a directory for static files (collected) and give ownership to django user
RUN mkdir -p /staticfiles && \
    chown -R django:django /app /staticfiles

# Temporary dummy secret for static collection (overridden at runtime)
ENV SECRET_KEY=dummy-key-for-build-only
ENV SMS_IR_API_KEY="kcIO0EnMsEVFJCgeQxF82KTiAzn2G2eaFirpsJZSnxEpk5SF"


ENV STATIC_ROOT=/staticfiles

RUN python manage.py collectstatic --noinput

# After creating the django user, add these lines:
RUN mkdir -p /home/django && chown -R django:django /home/django
# Switch to non‑root user
USER django
ENV HOME=/home/django

ENV PYTHONPATH=/app 
WORKDIR /app
# Expose the port that Gunicorn will listen on
EXPOSE 8000

# Run Gunicorn with 4 workers 
# Using core.wsgi:application – adjust if your WSGI file is at a different path
CMD ["gunicorn", "core.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "4", "--threads", "2"]